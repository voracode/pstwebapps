// =============================================================================
//  PARTIDO SOCIALISTA DE TIMOR (PST) — Portal, SIM-PST & Backoffice
//  "Pelo Progresso, Igualdade"
//
//  Prisma 7 schema · PostgreSQL 16+
//  - Connection URL lives in prisma.config.ts (Prisma 7 no longer reads it here).
//  - Runtime client uses the @prisma/adapter-pg driver adapter (src/lib/db.ts).
//
//  Conventions
//  - Tables/columns are snake_case in Postgres (@@map / @map), camelCase in TS.
//  - Business entities use cuid() string ids; geography and high-volume logs
//    use integer / bigint ids.
//  - Every translatable entity has a sibling *Translation model keyed by
//    (parentId, locale). Tetum (tet) is the default/fallback locale.
//  - legacySource + legacyId keep a trace back to the old PHP/MariaDB site
//    (pst_db) so the migration script can run idempotently.
//  - Sensitive personal identifiers are stored AES-256-GCM encrypted (*Enc)
//    with an HMAC-SHA256 blind index (*Hash) for exact-match lookups.
// =============================================================================

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// =============================================================================
//  ENUMS
// =============================================================================

enum Locale {
  TET @map("tet")
  PT  @map("pt")
  ID  @map("id")
  EN  @map("en")

  @@map("locale")
}

enum Role {
  SUPER_ADMIN
  NATIONAL_SECRETARY
  MUNICIPAL_COORDINATOR
  MEDIA_EDITOR
  AUDITOR

  @@map("role")
}

enum UserStatus {
  ACTIVE
  DISABLED

  @@map("user_status")
}

enum Gender {
  MALE
  FEMALE

  @@map("gender")
}

enum MemberStatus {
  PENDING
  VERIFIED
  REJECTED
  SUSPENDED

  @@map("member_status")
}

enum MemberRank {
  SYMPATHIZER
  MILITANT
  CADRE

  @@map("member_rank")
}

enum IdDocumentType {
  BILHETE_IDENTIDADE // Bilhete de Identidade (BI)
  CARTAO_ELEITORAL // Cartão de Eleitor
  PASSPORT
  OTHER

  @@map("id_document_type")
}

enum EducationLevel {
  NONE
  PRIMARY
  PRE_SECONDARY
  SECONDARY
  VOCATIONAL
  DIPLOMA
  BACHELOR
  MASTER
  DOCTORATE

  @@map("education_level")
}

enum RegistrationChannel {
  ONLINE
  FIELD_IMPORT
  BACKOFFICE
  LEGACY_MIGRATION

  @@map("registration_channel")
}

enum PostType {
  NEWS // Notísia
  PRESS_RELEASE // Comunicado de Imprensa
  ARTICLE // Artigu / Opinião
  STATEMENT // Political statement (hero ticker)

  @@map("post_type")
}

enum PublishStatus {
  DRAFT
  IN_REVIEW
  SCHEDULED
  PUBLISHED
  ARCHIVED

  @@map("publish_status")
}

enum MediaKind {
  IMAGE
  VIDEO
  AUDIO
  DOCUMENT
  VIDEO_EMBED // YouTube / Facebook / Vimeo URL — no stored file

  @@map("media_kind")
}

enum MediaVisibility {
  PUBLIC // served from the public CDN path
  PRIVATE // member photos, ID scans, aspiration attachments — signed URLs only

  @@map("media_visibility")
}

enum DocumentType {
  STATUTE // Estatuto do Partido
  POLITICAL_PROGRAM // Programa Político
  MANIFESTO
  BULLETIN
  LEGISLATION
  RESOLUTION
  REPORT
  OTHER

  @@map("document_type")
}

enum EventType {
  CONGRESS
  RALLY
  COMMUNITY_DISCUSSION
  POLITICAL_EDUCATION
  MEETING
  OTHER

  @@map("event_type")
}

enum EventStatus {
  DRAFT
  SCHEDULED
  ONGOING
  COMPLETED
  POSTPONED
  CANCELLED

  @@map("event_status")
}

enum AttendanceMethod {
  QR_SCAN
  MANUAL
  SELF_CHECKIN

  @@map("attendance_method")
}

enum LeadershipLevel {
  PRESIDENCY
  POLITICAL_COMMISSION
  CENTRAL_COMMITTEE
  NATIONAL_SECRETARIAT
  MUNICIPAL_COMMITTEE
  WING // Women's / Youth / Workers' organisations

  @@map("leadership_level")
}

enum PageKey {
  ABOUT
  HISTORY
  IDEOLOGY
  PROGRAM

  @@map("page_key")
}

enum AspirationCategory {
  LAND_PROPERTY
  AGRICULTURE_FISHERIES
  LABOUR_EMPLOYMENT
  EDUCATION
  HEALTH
  INFRASTRUCTURE
  WATER_SANITATION
  ELECTRICITY
  SOCIAL_PROTECTION
  CORRUPTION_GOVERNANCE
  YOUTH
  WOMEN_GENDER
  VETERANS
  OTHER

  @@map("aspiration_category")
}

enum SubmitterType {
  CITIZEN
  WORKER
  FARMER
  FISHER
  STUDENT
  VETERAN
  PARTY_MEMBER
  OTHER

  @@map("submitter_type")
}

enum TicketStatus {
  NEW
  ACKNOWLEDGED
  IN_REVIEW
  FORWARDED
  RESOLVED
  CLOSED
  SPAM

  @@map("ticket_status")
}

enum TicketPriority {
  LOW
  NORMAL
  HIGH
  URGENT

  @@map("ticket_priority")
}

enum AuditSeverity {
  INFO
  WARNING
  CRITICAL

  @@map("audit_severity")
}

enum NotificationChannel {
  TELEGRAM
  EMAIL

  @@map("notification_channel")
}

enum NotificationStatus {
  QUEUED
  SENDING
  SENT
  FAILED

  @@map("notification_status")
}

enum ImportStatus {
  UPLOADED
  VALIDATING
  READY
  PROCESSING
  COMPLETED
  FAILED
  CANCELLED

  @@map("import_status")
}

// =============================================================================
//  GEOGRAPHY — Município → Posto Administrativo → Suco → Aldeia
// =============================================================================

model Municipality {
  id              Int      @id @default(autoincrement())
  /// ISO 3166-2:TL subdivision suffix, e.g. "DI" (Dili), "OE" (Oé-Cusse Ambeno)
  code            String   @unique @db.VarChar(4)
  name            String   @unique @db.VarChar(80)
  slug            String   @unique @db.VarChar(80)
  officialName    String?  @map("official_name") @db.VarChar(160)
  capital         String?  @db.VarChar(80)
  isSpecialRegion Boolean  @default(false) @map("is_special_region")
  latitude        Decimal? @db.Decimal(9, 6)
  longitude       Decimal? @db.Decimal(9, 6)
  sortOrder       Int      @default(0) @map("sort_order")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  adminPosts      AdminPost[]
  members         Member[]
  users           User[]
  branchOffices   BranchOffice[]
  leadership      Leadership[]
  events          Event[]
  aspirations     Aspiration[]
  posts           Post[]
  memberSequences MemberNumberSequence[]

  @@map("municipalities")
}

model AdminPost {
  id             Int      @id @default(autoincrement())
  municipalityId Int      @map("municipality_id")
  code           String?  @unique @db.VarChar(16)
  name           String   @db.VarChar(80)
  slug           String   @db.VarChar(100)
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  municipality  Municipality   @relation(fields: [municipalityId], references: [id], onDelete: Restrict)
  sucos         Suco[]
  members       Member[]
  branchOffices BranchOffice[]

  @@unique([municipalityId, slug])
  @@index([municipalityId])
  @@map("admin_posts")
}

model Suco {
  id          Int      @id @default(autoincrement())
  adminPostId Int      @map("admin_post_id")
  code        String?  @unique @db.VarChar(16)
  name        String   @db.VarChar(80)
  slug        String   @db.VarChar(100)
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  adminPost   AdminPost    @relation(fields: [adminPostId], references: [id], onDelete: Restrict)
  aldeias     Aldeia[]
  members     Member[]
  events      Event[]
  aspirations Aspiration[]

  @@unique([adminPostId, slug])
  @@index([adminPostId])
  @@map("sucos")
}

model Aldeia {
  id        Int      @id @default(autoincrement())
  sucoId    Int      @map("suco_id")
  code      String?  @unique @db.VarChar(20)
  name      String   @db.VarChar(80)
  slug      String   @db.VarChar(100)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  suco    Suco     @relation(fields: [sucoId], references: [id], onDelete: Restrict)
  members Member[]

  @@unique([sucoId, slug])
  @@index([sucoId])
  @@map("aldeias")
}

// =============================================================================
//  BACKOFFICE USERS, SESSIONS & CREDENTIALS
// =============================================================================

model User {
  id              String     @id @default(cuid())
  email           String     @unique @db.VarChar(160) /// always stored lower-cased
  name            String     @db.VarChar(120)
  phone           String?    @db.VarChar(32)
  role            Role
  status          UserStatus @default(ACTIVE)
  /// Required for MUNICIPAL_COORDINATOR — limits data access to one município.
  municipalityId  Int?       @map("municipality_id")
  preferredLocale Locale     @default(TET) @map("preferred_locale")

  // ---- credentials -------------------------------------------------------
  passwordHash       String    @map("password_hash") /// argon2id PHC string
  mustChangePassword Boolean   @default(true) @map("must_change_password")
  passwordChangedAt  DateTime? @map("password_changed_at")

  // ---- brute-force protection -------------------------------------------
  failedLoginCount Int       @default(0) @map("failed_login_count")
  lockedUntil      DateTime? @map("locked_until")
  lastLoginAt      DateTime? @map("last_login_at")
  lastLoginIp      String?   @map("last_login_ip") @db.Inet

  // ---- 2FA (TOTP, RFC 6238) ---------------------------------------------
  twoFactorEnabled   Boolean   @default(false) @map("two_factor_enabled")
  twoFactorSecretEnc String?   @map("two_factor_secret_enc") /// AES-256-GCM encrypted base32 secret
  twoFactorEnabledAt DateTime? @map("two_factor_enabled_at")

  /// Personal Telegram chat id for direct alerts (optional).
  telegramChatId String? @map("telegram_chat_id") @db.VarChar(32)

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  municipality        Municipality?        @relation(fields: [municipalityId], references: [id], onDelete: SetNull)
  sessions            UserSession[]
  recoveryCodes       UserRecoveryCode[]
  passwordResetTokens PasswordResetToken[]
  passwordHistory     PasswordHistory[]
  auditLogs           AuditLog[]

  membersCreated      Member[]             @relation("MemberCreatedBy")
  membersVerified     Member[]             @relation("MemberVerifiedBy")
  memberStatusChanges MemberStatusChange[]
  cardsIssued         MembershipCard[]
  postsAuthored       Post[]               @relation("PostAuthor")
  postsReviewed       Post[]               @relation("PostReviewer")
  mediaUploaded       MediaAsset[]
  documentsCreated    Document[]
  eventsCreated       Event[]
  attendanceRecorded  EventAttendance[]
  aspirationsAssigned Aspiration[]
  aspirationNotes     AspirationNote[]
  contactMessagesRead ContactMessage[]
  importJobs          ImportJob[]
  settingsUpdated     SiteSetting[]

  @@index([role])
  @@index([municipalityId])
  @@map("users")
}

model UserSession {
  id                String    @id @default(cuid())
  userId            String    @map("user_id")
  /// SHA-256 of the opaque session token; the raw token only lives in the cookie.
  tokenHash         String    @unique @map("token_hash") @db.VarChar(64)
  twoFactorVerified Boolean   @default(false) @map("two_factor_verified")
  ipAddress         String?   @map("ip_address") @db.Inet
  userAgent         String?   @map("user_agent") @db.VarChar(512)
  createdAt         DateTime  @default(now()) @map("created_at")
  lastSeenAt        DateTime  @default(now()) @map("last_seen_at")
  expiresAt         DateTime  @map("expires_at")
  revokedAt         DateTime? @map("revoked_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("user_sessions")
}

model UserRecoveryCode {
  id        String    @id @default(cuid())
  userId    String    @map("user_id")
  codeHash  String    @map("code_hash") /// HMAC-SHA256 blind index (codes are high-entropy)
  usedAt    DateTime? @map("used_at")
  createdAt DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("user_recovery_codes")
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String    @map("user_id")
  tokenHash String    @unique @map("token_hash") @db.VarChar(64)
  expiresAt DateTime  @map("expires_at")
  usedAt    DateTime? @map("used_at")
  ipAddress String?   @map("ip_address") @db.Inet
  createdAt DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("password_reset_tokens")
}

/// Last N password hashes per user, to block password reuse on rotation.
model PasswordHistory {
  id           String   @id @default(cuid())
  userId       String   @map("user_id")
  passwordHash String   @map("password_hash")
  createdAt    DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@map("password_history")
}

// =============================================================================
//  SIM-PST — MILITANTS & CADRES
// =============================================================================

model Member {
  id              String              @id @default(cuid())
  /// Public KTA number, assigned on verification: PST-<MUN>-<YYYY>-<NNNNNN>
  memberNumber    String?             @unique @map("member_number") @db.VarChar(32)
  /// Reference given to the applicant at submission, used to check status.
  registrationRef String              @unique @map("registration_ref") @db.VarChar(24)
  /// Random, rotatable token encoded in the KTA QR code (verification URL).
  qrToken         String              @unique @map("qr_token") @db.VarChar(64) /// 32 random bytes, base64url — generated in app (crypto), never cuid
  status          MemberStatus        @default(PENDING)
  rank            MemberRank          @default(MILITANT)
  channel         RegistrationChannel @default(ONLINE)

  // ---- identity ----------------------------------------------------------
  fullName       String          @map("full_name") @db.VarChar(180)
  gender         Gender
  birthDate      DateTime        @map("birth_date") @db.Date
  birthPlace     String?         @map("birth_place") @db.VarChar(120)
  idDocumentType IdDocumentType  @default(BILHETE_IDENTIDADE) @map("id_document_type")
  idNumberEnc    String?         @map("id_number_enc") /// AES-256-GCM ciphertext
  idNumberHash   String?         @unique @map("id_number_hash") @db.VarChar(64) /// HMAC blind index (dedup)
  idNumberLast4  String?         @map("id_number_last4") @db.VarChar(4)
  occupation     String?         @db.VarChar(160)
  educationLevel EducationLevel? @map("education_level")

  // ---- contact -----------------------------------------------------------
  phone String? @db.VarChar(32) /// E.164, e.g. +67077xxxxxx
  email String? @db.VarChar(160)

  // ---- address (Timor-Leste administrative hierarchy) --------------------
  municipalityId Int     @map("municipality_id")
  adminPostId    Int?    @map("admin_post_id")
  sucoId         Int?    @map("suco_id")
  aldeiaId       Int?    @map("aldeia_id")
  addressLine    String? @map("address_line") @db.VarChar(255)

  // ---- uploads (private media) -------------------------------------------
  photoId          String? @unique @map("photo_id")
  idDocumentScanId String? @unique @map("id_document_scan_id")

  // ---- application -------------------------------------------------------
  motivation     String?  @db.Text
  /// Version of the privacy notice / statute the applicant accepted.
  consentVersion String   @map("consent_version") @db.VarChar(20)
  consentAt      DateTime @map("consent_at")
  submittedIp    String?  @map("submitted_ip") @db.Inet

  // ---- workflow ----------------------------------------------------------
  joinedAt         DateTime? @map("joined_at") @db.Date
  verifiedAt       DateTime? @map("verified_at")
  verifiedById     String?   @map("verified_by_id")
  rejectionReason  String?   @map("rejection_reason") @db.Text
  suspensionReason String?   @map("suspension_reason") @db.Text
  createdById      String?   @map("created_by_id")
  importJobId      String?   @map("import_job_id")

  legacySource String? @map("legacy_source") @db.VarChar(40)
  legacyId     Int?    @map("legacy_id")

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  municipality   Municipality @relation(fields: [municipalityId], references: [id], onDelete: Restrict)
  adminPost      AdminPost?   @relation(fields: [adminPostId], references: [id], onDelete: SetNull)
  suco           Suco?        @relation(fields: [sucoId], references: [id], onDelete: SetNull)
  aldeia         Aldeia?      @relation(fields: [aldeiaId], references: [id], onDelete: SetNull)
  photo          MediaAsset?  @relation("MemberPhoto", fields: [photoId], references: [id], onDelete: SetNull)
  idDocumentScan MediaAsset?  @relation("MemberIdScan", fields: [idDocumentScanId], references: [id], onDelete: SetNull)
  verifiedBy     User?        @relation("MemberVerifiedBy", fields: [verifiedById], references: [id], onDelete: SetNull)
  createdBy      User?        @relation("MemberCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  importJob      ImportJob?   @relation(fields: [importJobId], references: [id], onDelete: SetNull)

  statusChanges   MemberStatusChange[]
  cards           MembershipCard[]
  attendances     EventAttendance[]
  leadershipRoles Leadership[]

  @@unique([legacySource, legacyId])
  @@index([status])
  @@index([municipalityId, status])
  @@index([adminPostId])
  @@index([sucoId])
  @@index([aldeiaId])
  @@index([gender, birthDate])
  @@index([phone])
  @@index([createdAt])
  @@index([fullName])
  @@map("members")
}

/// Immutable history of approval-workflow transitions.
model MemberStatusChange {
  id          String        @id @default(cuid())
  memberId    String        @map("member_id")
  fromStatus  MemberStatus? @map("from_status")
  toStatus    MemberStatus  @map("to_status")
  reason      String?       @db.Text
  changedById String?       @map("changed_by_id")
  createdAt   DateTime      @default(now()) @map("created_at")

  member    Member @relation(fields: [memberId], references: [id], onDelete: Cascade)
  changedBy User?  @relation(fields: [changedById], references: [id], onDelete: SetNull)

  @@index([memberId, createdAt])
  @@map("member_status_changes")
}

/// Issued KTA cards. A re-issue creates a new row and revokes the previous one.
model MembershipCard {
  id         String    @id @default(cuid())
  memberId   String    @map("member_id")
  version    Int       @default(1)
  issuedAt   DateTime  @default(now()) @map("issued_at")
  expiresAt  DateTime? @map("expires_at")
  revokedAt  DateTime? @map("revoked_at")
  /// Canonical JSON payload that was signed (member number, name, issue date…).
  payload    Json
  /// Ed25519 signature (base64url) over `payload` — verified by the QR endpoint.
  signature  String
  signingKid String    @map("signing_kid") @db.VarChar(32)
  pdfKey     String?   @map("pdf_key") /// storage key of rendered PDF
  pngKey     String?   @map("png_key") /// storage key of rendered PNG
  issuedById String?   @map("issued_by_id")

  member   Member @relation(fields: [memberId], references: [id], onDelete: Cascade)
  issuedBy User?  @relation(fields: [issuedById], references: [id], onDelete: SetNull)

  @@unique([memberId, version])
  @@map("membership_cards")
}

/// Atomic counter backing KTA number generation per município per year.
model MemberNumberSequence {
  municipalityId Int @map("municipality_id")
  year           Int
  lastValue      Int @default(0) @map("last_value")

  municipality Municipality @relation(fields: [municipalityId], references: [id], onDelete: Cascade)

  @@id([municipalityId, year])
  @@map("member_number_sequences")
}

/// Bulk CSV/Excel import of offline field registrations.
model ImportJob {
  id          String       @id @default(cuid())
  fileName    String       @map("file_name") @db.VarChar(255)
  fileKey     String       @map("file_key")
  status      ImportStatus @default(UPLOADED)
  totalRows   Int          @default(0) @map("total_rows")
  successRows Int          @default(0) @map("success_rows")
  errorRows   Int          @default(0) @map("error_rows")
  /// [{ row: number, field: string, message: string }]
  errors      Json?
  createdById String       @map("created_by_id")
  startedAt   DateTime?    @map("started_at")
  finishedAt  DateTime?    @map("finished_at")
  createdAt   DateTime     @default(now()) @map("created_at")

  createdBy User     @relation(fields: [createdById], references: [id], onDelete: Restrict)
  members   Member[]

  @@index([createdById])
  @@map("import_jobs")
}

// =============================================================================
//  MEDIA LIBRARY
// =============================================================================

model MediaAsset {
  id           String          @id @default(cuid())
  kind         MediaKind
  visibility   MediaVisibility @default(PUBLIC)
  /// Object key in local volume / S3-compatible storage. Null for VIDEO_EMBED.
  storageKey   String?         @unique @map("storage_key")
  externalUrl  String?         @map("external_url") @db.VarChar(500)
  originalName String?         @map("original_name") @db.VarChar(255)
  mimeType     String?         @map("mime_type") @db.VarChar(100)
  sizeBytes    Int?            @map("size_bytes")
  width        Int?
  height       Int?
  durationSec  Int?            @map("duration_sec")
  sha256       String?         @db.VarChar(64)
  /// Low-quality blurred placeholder (base64) for slow networks.
  blurDataUrl  String?         @map("blur_data_url") @db.Text
  /// { tet?: string, pt?: string, id?: string, en?: string }
  altText      Json?           @map("alt_text")
  credit       String?         @db.VarChar(160)
  uploadedById String?         @map("uploaded_by_id")

  legacySource String? @map("legacy_source") @db.VarChar(40)
  legacyId     Int?    @map("legacy_id")

  createdAt DateTime  @default(now()) @map("created_at")
  deletedAt DateTime? @map("deleted_at")

  uploadedBy       User?                  @relation(fields: [uploadedById], references: [id], onDelete: SetNull)
  memberPhoto      Member?                @relation("MemberPhoto")
  memberIdScan     Member?                @relation("MemberIdScan")
  postCovers       Post[]
  documentFiles    DocumentTranslation[]
  eventCovers      Event[]
  leadershipPhotos Leadership[]
  albumItems       AlbumItem[]
  albumCovers      Album[]
  heroSlides       HeroSlide[]
  aspirationFiles  AspirationAttachment[]

  @@unique([legacySource, legacyId])
  @@index([kind, visibility])
  @@index([sha256])
  @@index([createdAt])
  @@map("media_assets")
}

model Album {
  id          String        @id @default(cuid())
  slug        String        @unique @db.VarChar(160)
  coverId     String?       @map("cover_id")
  eventId     String?       @map("event_id")
  status      PublishStatus @default(DRAFT)
  publishedAt DateTime?     @map("published_at")
  createdAt   DateTime      @default(now()) @map("created_at")
  updatedAt   DateTime      @updatedAt @map("updated_at")

  cover        MediaAsset?        @relation(fields: [coverId], references: [id], onDelete: SetNull)
  event        Event?             @relation(fields: [eventId], references: [id], onDelete: SetNull)
  translations AlbumTranslation[]
  items        AlbumItem[]

  @@index([status, publishedAt])
  @@map("albums")
}

model AlbumTranslation {
  id          String  @id @default(cuid())
  albumId     String  @map("album_id")
  locale      Locale
  title       String  @db.VarChar(220)
  description String? @db.Text

  album Album @relation(fields: [albumId], references: [id], onDelete: Cascade)

  @@unique([albumId, locale])
  @@map("album_translations")
}

model AlbumItem {
  albumId   String @map("album_id")
  mediaId   String @map("media_id")
  sortOrder Int    @default(0) @map("sort_order")
  /// { tet?: string, pt?: string, id?: string, en?: string }
  caption   Json?

  album Album      @relation(fields: [albumId], references: [id], onDelete: Cascade)
  media MediaAsset @relation(fields: [mediaId], references: [id], onDelete: Cascade)

  @@id([albumId, mediaId])
  @@index([albumId, sortOrder])
  @@map("album_items")
}

// =============================================================================
//  CMS — NEWS, PRESS RELEASES, ARTICLES, STATEMENTS
// =============================================================================

model Category {
  id        String   @id @default(cuid())
  key       String   @unique @db.VarChar(60)
  sortOrder Int      @default(0) @map("sort_order")
  createdAt DateTime @default(now()) @map("created_at")

  translations CategoryTranslation[]
  posts        Post[]

  @@map("categories")
}

model CategoryTranslation {
  id         String @id @default(cuid())
  categoryId String @map("category_id")
  locale     Locale
  name       String @db.VarChar(80)
  slug       String @db.VarChar(100)

  category Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@unique([categoryId, locale])
  @@unique([locale, slug])
  @@map("category_translations")
}

model Tag {
  id    String @id @default(cuid())
  slug  String @unique @db.VarChar(80)
  label String @db.VarChar(80)

  posts Post[]

  @@map("tags")
}

model Post {
  id             String        @id @default(cuid())
  type           PostType      @default(NEWS)
  status         PublishStatus @default(DRAFT)
  categoryId     String?       @map("category_id")
  /// Optional municipal scope (news from a local branch).
  municipalityId Int?          @map("municipality_id")
  coverId        String?       @map("cover_id")
  authorId       String?       @map("author_id")
  /// Display byline (e.g. "Comité Central do PST") when it differs from the user.
  byline         String?       @db.VarChar(160)
  reviewedById   String?       @map("reviewed_by_id")
  isFeatured     Boolean       @default(false) @map("is_featured")
  /// Shown in the hero "latest political statements" strip.
  pinnedToHero   Boolean       @default(false) @map("pinned_to_hero")
  /// Optional attached PDF (official communiqué).
  attachmentId   String?       @map("attachment_id")
  publishedAt    DateTime?     @map("published_at")
  scheduledAt    DateTime?     @map("scheduled_at")
  viewCount      Int           @default(0) @map("view_count")

  legacySource String? @map("legacy_source") @db.VarChar(40)
  legacyId     Int?    @map("legacy_id")

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  category     Category?         @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  municipality Municipality?     @relation(fields: [municipalityId], references: [id], onDelete: SetNull)
  cover        MediaAsset?       @relation(fields: [coverId], references: [id], onDelete: SetNull)
  author       User?             @relation("PostAuthor", fields: [authorId], references: [id], onDelete: SetNull)
  reviewedBy   User?             @relation("PostReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)
  attachment   Document?         @relation(fields: [attachmentId], references: [id], onDelete: SetNull)
  translations PostTranslation[]
  tags         Tag[]
  dailyViews   PostViewDaily[]

  @@unique([legacySource, legacyId])
  @@index([type, status, publishedAt(sort: Desc)])
  @@index([status, scheduledAt])
  @@index([categoryId])
  @@index([municipalityId])
  @@index([pinnedToHero, publishedAt(sort: Desc)])
  @@map("posts")
}

model PostTranslation {
  id             String   @id @default(cuid())
  postId         String   @map("post_id")
  locale         Locale
  title          String   @db.VarChar(220)
  slug           String   @db.VarChar(240)
  excerpt        String?  @db.Text
  /// Rich-text editor document (TipTap JSON) — source of truth for editing.
  contentJson    Json?    @map("content_json")
  /// Server-rendered, sanitised HTML — what the public site renders.
  contentHtml    String?  @map("content_html") @db.Text
  seoTitle       String?  @map("seo_title") @db.VarChar(70)
  seoDescription String?  @map("seo_description") @db.VarChar(170)
  readingMinutes Int?     @map("reading_minutes")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  post Post @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@unique([postId, locale])
  @@unique([locale, slug])
  @@map("post_translations")
}

/// Daily aggregate of page views (flushed from Redis counters by a cron job).
model PostViewDaily {
  postId String   @map("post_id")
  day    DateTime @db.Date
  views  Int      @default(0)

  post Post @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@id([postId, day])
  @@index([day])
  @@map("post_views_daily")
}

// =============================================================================
//  OFFICIAL DOCUMENTS (Estatuto, Programa Político, manifestos, bulletins…)
// =============================================================================

model Document {
  id            String       @id @default(cuid())
  type          DocumentType
  slug          String       @unique @db.VarChar(160)
  /// e.g. "2024" or "v3.1" — documents like the Statute get revised by congress.
  versionLabel  String?      @map("version_label") @db.VarChar(40)
  isPublic      Boolean      @default(true) @map("is_public")
  isFeatured    Boolean      @default(false) @map("is_featured")
  publishedAt   DateTime?    @map("published_at")
  downloadCount Int          @default(0) @map("download_count")
  createdById   String?      @map("created_by_id")

  legacySource String? @map("legacy_source") @db.VarChar(40)
  legacyId     Int?    @map("legacy_id")

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  createdBy    User?                 @relation(fields: [createdById], references: [id], onDelete: SetNull)
  translations DocumentTranslation[]
  posts        Post[]

  @@unique([legacySource, legacyId])
  @@index([type, isPublic, publishedAt(sort: Desc)])
  @@map("documents")
}

/// Each language may have its own PDF (e.g. Statute in PT and TET).
model DocumentTranslation {
  id          String  @id @default(cuid())
  documentId  String  @map("document_id")
  locale      Locale
  title       String  @db.VarChar(220)
  description String? @db.Text
  fileId      String? @map("file_id")

  document Document    @relation(fields: [documentId], references: [id], onDelete: Cascade)
  file     MediaAsset? @relation(fields: [fileId], references: [id], onDelete: SetNull)

  @@unique([documentId, locale])
  @@map("document_translations")
}

// =============================================================================
//  STATIC CONTENT — About / History / Ideology / Program pillars, Hero
// =============================================================================

model PageSection {
  id        String  @id @default(cuid())
  page      PageKey
  /// Lucide icon name for program pillars (e.g. "graduation-cap").
  icon      String? @db.VarChar(50)
  sortOrder Int     @default(0) @map("sort_order")
  isVisible Boolean @default(true) @map("is_visible")

  legacySource String? @map("legacy_source") @db.VarChar(40)
  legacyId     Int?    @map("legacy_id")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  translations PageSectionTranslation[]

  @@unique([legacySource, legacyId])
  @@index([page, sortOrder])
  @@map("page_sections")
}

model PageSectionTranslation {
  id          String @id @default(cuid())
  sectionId   String @map("section_id")
  locale      Locale
  title       String @db.VarChar(220)
  contentHtml String @map("content_html") @db.Text
  contentJson Json?  @map("content_json")

  section PageSection @relation(fields: [sectionId], references: [id], onDelete: Cascade)

  @@unique([sectionId, locale])
  @@map("page_section_translations")
}

model HeroSlide {
  id        String    @id @default(cuid())
  imageId   String?   @map("image_id")
  /// Internal path or absolute URL for the CTA button.
  ctaHref   String?   @map("cta_href") @db.VarChar(255)
  sortOrder Int       @default(0) @map("sort_order")
  isActive  Boolean   @default(true) @map("is_active")
  startsAt  DateTime? @map("starts_at")
  endsAt    DateTime? @map("ends_at")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")

  image        MediaAsset?            @relation(fields: [imageId], references: [id], onDelete: SetNull)
  translations HeroSlideTranslation[]

  @@index([isActive, sortOrder])
  @@map("hero_slides")
}

model HeroSlideTranslation {
  id       String  @id @default(cuid())
  slideId  String  @map("slide_id")
  locale   Locale
  headline String  @db.VarChar(160)
  subline  String? @db.VarChar(300)
  ctaLabel String? @map("cta_label") @db.VarChar(60)

  slide HeroSlide @relation(fields: [slideId], references: [id], onDelete: Cascade)

  @@unique([slideId, locale])
  @@map("hero_slide_translations")
}

/// Key/value store for site-wide settings (motto, contacts, social links…).
model SiteSetting {
  key         String   @id @db.VarChar(80)
  value       Json
  updatedById String?  @map("updated_by_id")
  updatedAt   DateTime @updatedAt @map("updated_at")

  updatedBy User? @relation(fields: [updatedById], references: [id], onDelete: SetNull)

  @@map("site_settings")
}

// =============================================================================
//  ORGANISATION — Leadership & municipal branch offices
// =============================================================================

model Leadership {
  id             String          @id @default(cuid())
  level          LeadershipLevel
  /// Null for national organs; set for MUNICIPAL_COMMITTEE positions.
  municipalityId Int?            @map("municipality_id")
  /// Link to the person's SIM-PST record when they are a registered member.
  memberId       String?         @map("member_id")
  fullName       String          @map("full_name") @db.VarChar(180)
  photoId        String?         @map("photo_id")
  phone          String?         @db.VarChar(32)
  email          String?         @db.VarChar(160)
  isCoordinator  Boolean         @default(false) @map("is_coordinator")
  sortOrder      Int             @default(0) @map("sort_order")
  termStart      DateTime?       @map("term_start") @db.Date
  termEnd        DateTime?       @map("term_end") @db.Date
  isActive       Boolean         @default(true) @map("is_active")

  legacySource String? @map("legacy_source") @db.VarChar(40)
  legacyId     Int?    @map("legacy_id")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  municipality  Municipality?           @relation(fields: [municipalityId], references: [id], onDelete: Cascade)
  member        Member?                 @relation(fields: [memberId], references: [id], onDelete: SetNull)
  photo         MediaAsset?             @relation(fields: [photoId], references: [id], onDelete: SetNull)
  translations  LeadershipTranslation[]
  branchOffices BranchOffice[]

  @@unique([legacySource, legacyId])
  @@index([level, isActive, sortOrder])
  @@index([municipalityId])
  @@map("leadership")
}

model LeadershipTranslation {
  id            String  @id @default(cuid())
  leadershipId  String  @map("leadership_id")
  locale        Locale
  /// e.g. "Secretário-Geral", "Koordenador Munisipál"
  positionTitle String  @map("position_title") @db.VarChar(220)
  bio           String? @db.Text

  leadership Leadership @relation(fields: [leadershipId], references: [id], onDelete: Cascade)

  @@unique([leadershipId, locale])
  @@map("leadership_translations")
}

model BranchOffice {
  id             String   @id @default(cuid())
  municipalityId Int      @map("municipality_id")
  adminPostId    Int?     @map("admin_post_id")
  coordinatorId  String?  @map("coordinator_id")
  name           String   @db.VarChar(160)
  address        String?  @db.VarChar(255)
  phone          String?  @db.VarChar(32)
  email          String?  @db.VarChar(160)
  latitude       Decimal? @db.Decimal(9, 6)
  longitude      Decimal? @db.Decimal(9, 6)
  /// { tet?: string, pt?: string, ... } e.g. "Segunda–Sexta 08:00–17:00"
  openingHours   Json?    @map("opening_hours")
  isHeadquarters Boolean  @default(false) @map("is_headquarters")
  isActive       Boolean  @default(true) @map("is_active")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  municipality Municipality @relation(fields: [municipalityId], references: [id], onDelete: Cascade)
  adminPost    AdminPost?   @relation(fields: [adminPostId], references: [id], onDelete: SetNull)
  coordinator  Leadership?  @relation(fields: [coordinatorId], references: [id], onDelete: SetNull)

  @@index([municipalityId, isActive])
  @@map("branch_offices")
}

// =============================================================================
//  EVENTS & MOBILISATION
// =============================================================================

model Event {
  id              String      @id @default(cuid())
  slug            String      @unique @db.VarChar(160)
  type            EventType
  status          EventStatus @default(DRAFT)
  isPublic        Boolean     @default(true) @map("is_public")
  startsAt        DateTime    @map("starts_at")
  endsAt          DateTime?   @map("ends_at")
  /// IANA zone; Timor-Leste is UTC+9 with no DST.
  timezone        String      @default("Asia/Dili") @db.VarChar(40)
  municipalityId  Int?        @map("municipality_id")
  sucoId          Int?        @map("suco_id")
  venue           String?     @db.VarChar(200)
  latitude        Decimal?    @db.Decimal(9, 6)
  longitude       Decimal?    @db.Decimal(9, 6)
  coverId         String?     @map("cover_id")
  capacity        Int?
  expectedTurnout Int?        @map("expected_turnout")
  /// Rotatable token for attendee self check-in via QR poster.
  checkinToken    String      @unique @map("checkin_token") @db.VarChar(64) /// crypto-random, generated in app
  createdById     String?     @map("created_by_id")
  createdAt       DateTime    @default(now()) @map("created_at")
  updatedAt       DateTime    @updatedAt @map("updated_at")
  deletedAt       DateTime?   @map("deleted_at")

  municipality Municipality?      @relation(fields: [municipalityId], references: [id], onDelete: SetNull)
  suco         Suco?              @relation(fields: [sucoId], references: [id], onDelete: SetNull)
  cover        MediaAsset?        @relation(fields: [coverId], references: [id], onDelete: SetNull)
  createdBy    User?              @relation(fields: [createdById], references: [id], onDelete: SetNull)
  translations EventTranslation[]
  attendances  EventAttendance[]
  albums       Album[]

  @@index([startsAt])
  @@index([status, isPublic, startsAt])
  @@index([municipalityId, startsAt])
  @@map("events")
}

model EventTranslation {
  id          String  @id @default(cuid())
  eventId     String  @map("event_id")
  locale      Locale
  title       String  @db.VarChar(220)
  summary     String? @db.VarChar(400)
  contentHtml String? @map("content_html") @db.Text

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@unique([eventId, locale])
  @@map("event_translations")
}

model EventAttendance {
  id           String           @id @default(cuid())
  eventId      String           @map("event_id")
  /// Null for non-member guests (walk-ins).
  memberId     String?          @map("member_id")
  guestName    String?          @map("guest_name") @db.VarChar(180)
  guestPhone   String?          @map("guest_phone") @db.VarChar(32)
  guestGender  Gender?          @map("guest_gender")
  method       AttendanceMethod @default(MANUAL)
  checkedInAt  DateTime         @default(now()) @map("checked_in_at")
  recordedById String?          @map("recorded_by_id")

  event      Event   @relation(fields: [eventId], references: [id], onDelete: Cascade)
  member     Member? @relation(fields: [memberId], references: [id], onDelete: SetNull)
  recordedBy User?   @relation(fields: [recordedById], references: [id], onDelete: SetNull)

  @@unique([eventId, memberId])
  @@index([eventId, checkedInAt])
  @@map("event_attendances")
}

// =============================================================================
//  VOICE OF THE PEOPLE — Aspirations & contact inquiries
// =============================================================================

model Aspiration {
  id               String             @id @default(cuid())
  /// Human-friendly ticket number: ASP-2026-000123
  ticketNumber     String             @unique @map("ticket_number") @db.VarChar(24)
  /// SHA-256 of the secret tracking code given to the citizen.
  trackingCodeHash String             @unique @map("tracking_code_hash") @db.VarChar(64)
  category         AspirationCategory
  submitterType    SubmitterType      @default(CITIZEN) @map("submitter_type")
  isAnonymous      Boolean            @default(false) @map("is_anonymous")
  name             String?            @db.VarChar(180)
  phone            String?            @db.VarChar(32)
  email            String?            @db.VarChar(160)
  municipalityId   Int?               @map("municipality_id")
  sucoId           Int?               @map("suco_id")
  subject          String             @db.VarChar(220)
  message          String             @db.Text
  locale           Locale             @default(TET)
  status           TicketStatus       @default(NEW)
  priority         TicketPriority     @default(NORMAL)
  assignedToId     String?            @map("assigned_to_id")
  /// HMAC of the submitter IP — abuse throttling without storing raw IPs.
  ipHash           String?            @map("ip_hash") @db.VarChar(64)
  acknowledgedAt   DateTime?          @map("acknowledged_at")
  resolvedAt       DateTime?          @map("resolved_at")
  createdAt        DateTime           @default(now()) @map("created_at")
  updatedAt        DateTime           @updatedAt @map("updated_at")

  municipality Municipality?          @relation(fields: [municipalityId], references: [id], onDelete: SetNull)
  suco         Suco?                  @relation(fields: [sucoId], references: [id], onDelete: SetNull)
  assignedTo   User?                  @relation(fields: [assignedToId], references: [id], onDelete: SetNull)
  attachments  AspirationAttachment[]
  notes        AspirationNote[]

  @@index([status, createdAt])
  @@index([municipalityId, status])
  @@index([category])
  @@index([assignedToId])
  @@map("aspirations")
}

model AspirationAttachment {
  aspirationId String @map("aspiration_id")
  mediaId      String @map("media_id")

  aspiration Aspiration @relation(fields: [aspirationId], references: [id], onDelete: Cascade)
  media      MediaAsset @relation(fields: [mediaId], references: [id], onDelete: Cascade)

  @@id([aspirationId, mediaId])
  @@map("aspiration_attachments")
}

/// Internal notes and public replies on a ticket (isPublic → visible to citizen).
model AspirationNote {
  id           String   @id @default(cuid())
  aspirationId String   @map("aspiration_id")
  authorId     String?  @map("author_id")
  isPublic     Boolean  @default(false) @map("is_public")
  body         String   @db.Text
  createdAt    DateTime @default(now()) @map("created_at")

  aspiration Aspiration @relation(fields: [aspirationId], references: [id], onDelete: Cascade)
  author     User?      @relation(fields: [authorId], references: [id], onDelete: SetNull)

  @@index([aspirationId, createdAt])
  @@map("aspiration_notes")
}

model ContactMessage {
  id       String    @id @default(cuid())
  name     String    @db.VarChar(160)
  email    String?   @db.VarChar(160)
  phone    String?   @db.VarChar(32)
  subject  String?   @db.VarChar(220)
  message  String    @db.Text
  locale   Locale    @default(TET)
  ipHash   String?   @map("ip_hash") @db.VarChar(64)
  readAt   DateTime? @map("read_at")
  readById String?   @map("read_by_id")
  isSpam   Boolean   @default(false) @map("is_spam")

  legacySource String? @map("legacy_source") @db.VarChar(40)
  legacyId     Int?    @map("legacy_id")

  createdAt DateTime @default(now()) @map("created_at")

  readBy User? @relation(fields: [readById], references: [id], onDelete: SetNull)

  @@unique([legacySource, legacyId])
  @@index([readAt, createdAt])
  @@map("contact_messages")
}

// =============================================================================
//  SECURITY, AUDIT & NOTIFICATIONS
// =============================================================================

/// Append-only audit trail. Each row carries a SHA-256 hash chained to the
/// previous row (prevHash → hash) so tampering is detectable by the auditor.
/// Action naming convention: "<domain>.<verb>" e.g. "auth.login.failed",
/// "member.verified", "member.export", "post.published", "user.locked".
model AuditLog {
  id         BigInt        @id @default(autoincrement())
  actorId    String?       @map("actor_id")
  /// Snapshot so the trail survives user deletion / email change.
  actorEmail String?       @map("actor_email") @db.VarChar(160)
  actorRole  Role?         @map("actor_role")
  action     String        @db.VarChar(80)
  severity   AuditSeverity @default(INFO)
  entityType String?       @map("entity_type") @db.VarChar(60)
  entityId   String?       @map("entity_id") @db.VarChar(64)
  /// Diff / context — never store secrets or full ID numbers here.
  metadata   Json?
  ipAddress  String?       @map("ip_address") @db.Inet
  userAgent  String?       @map("user_agent") @db.VarChar(512)
  requestId  String?       @map("request_id") @db.VarChar(64)
  prevHash   String?       @map("prev_hash") @db.VarChar(64)
  hash       String        @db.VarChar(64)
  createdAt  DateTime      @default(now()) @map("created_at")

  actor User? @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([createdAt(sort: Desc)])
  @@index([actorId, createdAt(sort: Desc)])
  @@index([action, createdAt(sort: Desc)])
  @@index([entityType, entityId])
  @@index([severity, createdAt(sort: Desc)])
  @@map("audit_logs")
}

/// Durable outbox for Telegram / e-mail notifications. Workers pick rows from
/// a Redis queue; this table keeps delivery state for retries and reporting.
model NotificationOutbox {
  id          String              @id @default(cuid())
  channel     NotificationChannel
  /// Telegram chat id or e-mail address.
  recipient   String              @db.VarChar(200)
  template    String              @db.VarChar(80)
  payload     Json
  status      NotificationStatus  @default(QUEUED)
  attempts    Int                 @default(0)
  lastError   String?             @map("last_error") @db.Text
  scheduledAt DateTime            @default(now()) @map("scheduled_at")
  sentAt      DateTime?           @map("sent_at")
  createdAt   DateTime            @default(now()) @map("created_at")

  @@index([status, scheduledAt])
  @@map("notification_outbox")
}
