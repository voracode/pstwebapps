# dependencies
node_modules/
.pnpm-store/

# next.js
.next/
out/
next-env.d.ts
*.tsbuildinfo

# prisma generated client
src/generated/

# env & secrets — only .env.example is committed
.env
.env.*
!.env.example
*.pem
*.key

# runtime data (certificates, backups, logs, uploads) — anchored to the repo
# root with a leading "/", so source folders like src/lib/storage/ and
# prisma/data/ are NOT ignored.
/data/
/storage/
/uploads/
/backups/
/legacy/
*.sql
# …but database migrations are source code and must be versioned.
!prisma/migrations/**/migration.sql
*.sql.gz
*.dump

# legacy site archive (contains DB dump and credentials)
*.rar
*.zip

# OS / editor
.DS_Store
Thumbs.db
.vscode/*
!.vscode/extensions.json
.idea/

# logs
npm-debug.log*
*.log
