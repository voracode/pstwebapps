# =============================================================================
#  PST Portal — environment variables
#  Copy to `.env` (local) or `.env.production` (VPS, read by docker compose).
#  Generate secrets with:   openssl rand -base64 32
#  NEVER commit real values.
# =============================================================================

# ----------------------------------------------------------------------------
# App / domain
# ----------------------------------------------------------------------------
NODE_ENV=production
APP_NAME="Partido Socialista de Timor"
# Public canonical origin — used for links in e-mails, KTA QR codes, sitemap.
APP_URL=https://pst.tl
# Backoffice host (same app, separate hostname is optional).
ADMIN_URL=https://pst.tl/admin
DOMAIN=pst.tl
# Extra hostnames Nginx should answer for (comma-separated), e.g. www.pst.tl
DOMAIN_ALIASES=www.pst.tl
# Contact for Let's Encrypt expiry notices.
CERTBOT_EMAIL=tech@pst.tl
# Nginx: all hostnames served (space-separated) and the app upstream.
# Both are set by the deploy script; NGINX_UPSTREAM is 127.0.0.1:3000 on the VPS.
NGINX_SERVER_NAMES="pst.tl www.pst.tl"
NGINX_UPSTREAM=127.0.0.1:3000
TZ=Asia/Dili
DEFAULT_LOCALE=tet
SUPPORTED_LOCALES=tet,pt,id,en
# Port the Next.js standalone server listens on inside the container.
PORT=3000
HOSTNAME=0.0.0.0
# Trust X-Real-IP / X-Forwarded-For from Nginx. Set false if the app is
# ever exposed without the proxy in front (clients could spoof their IP).
TRUST_PROXY=true

# ----------------------------------------------------------------------------
# PostgreSQL 16
# ----------------------------------------------------------------------------
# Secrets left empty are generated by deploy-ubuntu-26.04.sh (never overwritten).
POSTGRES_DB=pst
# Schema owner — runs migrations and backups only.
POSTGRES_USER=pst_owner
POSTGRES_PASSWORD=
# Restricted role used by the app and worker (no DDL; audit_logs append-only).
APP_DB_USER=pst_app
APP_DB_PASSWORD=
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
# App connection string (restricted role). Inside docker compose the host is
# `postgres`; for local dev use localhost. URL-encode special characters.
DATABASE_URL=postgresql://pst_app:APP_DB_PASSWORD@postgres:5432/pst?schema=public
# Owner connection string, used only by the `migrate` job.
MIGRATE_DATABASE_URL=postgresql://pst_owner:POSTGRES_PASSWORD@postgres:5432/pst?schema=public
# Pool size per Next.js instance (pg driver adapter).
DATABASE_POOL_MAX=10

# Nightly pg_dump backup container
BACKUP_SCHEDULE="0 2 * * *"
BACKUP_KEEP_DAYS=14
BACKUP_KEEP_WEEKS=8
BACKUP_KEEP_MONTHS=6
# Optional: age/GPG public key — backups are encrypted at rest when set.
BACKUP_ENCRYPTION_PUBLIC_KEY=

# ----------------------------------------------------------------------------
# Redis 7 — sessions cache, rate limiting, OTP, notification queue
# ----------------------------------------------------------------------------
REDIS_PASSWORD=
REDIS_URL=redis://:REDIS_PASSWORD@redis:6379/0
REDIS_KEY_PREFIX=pst:

# ----------------------------------------------------------------------------
# Authentication & sessions (backoffice)
# ----------------------------------------------------------------------------
# Secret for signing session cookies / CSRF tokens (min 32 bytes, base64).
AUTH_SECRET=
SESSION_COOKIE_NAME=__Host-pst_session
SESSION_TTL_HOURS=8
SESSION_IDLE_TIMEOUT_MINUTES=30
# Issuer label shown in authenticator apps for TOTP 2FA.
TOTP_ISSUER="PST Backoffice"
# Require 2FA for these roles before they can access the dashboard.
TWO_FACTOR_REQUIRED_ROLES=SUPER_ADMIN,NATIONAL_SECRETARY,AUDITOR

# Brute-force protection
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCKOUT_MINUTES=15
LOGIN_IP_MAX_ATTEMPTS_PER_HOUR=30
PASSWORD_HISTORY_DEPTH=5
PASSWORD_MAX_AGE_DAYS=180

# ----------------------------------------------------------------------------
# Data protection (personal data of members / citizens)
# ----------------------------------------------------------------------------
# AES-256-GCM key for ID numbers and 2FA secrets — exactly 32 bytes, base64.
# Rotating this key requires a re-encryption job; keep an offline copy.
DATA_ENCRYPTION_KEY=
# Key id stored alongside ciphertext so keys can be rotated.
DATA_ENCRYPTION_KEY_ID=k2026a
# During key rotation only: the previous key + id, so old rows still decrypt.
DATA_ENCRYPTION_PREVIOUS_KEY=
DATA_ENCRYPTION_PREVIOUS_KEY_ID=
# HMAC-SHA256 key for blind indexes (ID-number dedup, IP hashing), base64.
BLIND_INDEX_KEY=

# ----------------------------------------------------------------------------
# KTA — digital membership card signing (Ed25519)
# Generate:  openssl genpkey -algorithm ed25519 -out kta.pem
#            openssl pkey -in kta.pem -pubout -out kta.pub.pem
# Paste PEMs as single line with literal \n, or mount as files.
# ----------------------------------------------------------------------------
KTA_SIGNING_KEY_ID=kta-2026-1
KTA_SIGNING_PRIVATE_KEY=
KTA_SIGNING_PUBLIC_KEY=
# After rotating the signing key: JSON map of old key ids → public PEMs so
# cards issued earlier keep verifying, e.g. {"kta-2026-1":"-----BEGIN PUBLIC KEY-----\n..."}
KTA_SIGNING_PREVIOUS_PUBLIC_KEYS=
# Base URL encoded in the card QR code: <KTA_VERIFY_URL>/<qrToken>
KTA_VERIFY_URL=https://pst.tl/verify
KTA_VALIDITY_YEARS=5

# ----------------------------------------------------------------------------
# File storage
# ----------------------------------------------------------------------------
# `local` stores under STORAGE_LOCAL_PATH (docker volume); `s3` for any
# S3-compatible bucket (MinIO, Cloudflare R2, Wasabi…).
STORAGE_DRIVER=local
STORAGE_LOCAL_PATH=/app/storage
# Public media served by Nginx from this URL prefix.
STORAGE_PUBLIC_BASE_URL=https://pst.tl/media
# Signed URLs for private files (member photos, ID scans).
STORAGE_SIGNED_URL_TTL_SECONDS=300
UPLOAD_MAX_IMAGE_MB=5
UPLOAD_MAX_DOCUMENT_MB=25
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET_PUBLIC=
S3_BUCKET_PRIVATE=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# ----------------------------------------------------------------------------
# Telegram Bot API — admin alerts
# Create bot with @BotFather; add it to the admin group; get the group chat
# id (negative number) from https://api.telegram.org/bot<TOKEN>/getUpdates
# ----------------------------------------------------------------------------
TELEGRAM_ENABLED=true
TELEGRAM_BOT_TOKEN=
# Default admin group for all alerts.
TELEGRAM_ADMIN_CHAT_ID=
# Optional per-topic routing (fall back to TELEGRAM_ADMIN_CHAT_ID when empty).
TELEGRAM_CHAT_ID_REGISTRATIONS=
TELEGRAM_CHAT_ID_ASPIRATIONS=
TELEGRAM_CHAT_ID_SECURITY=
TELEGRAM_CHAT_ID_SYSTEM=
# Secret path segment / header for the optional bot webhook.
TELEGRAM_WEBHOOK_SECRET=

# ----------------------------------------------------------------------------
# SMTP (Nodemailer)
# ----------------------------------------------------------------------------
SMTP_HOST=smtp.example.com
SMTP_PORT=587
# true for port 465 (implicit TLS); false for 587 (STARTTLS).
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM="PST — Partido Socialista de Timor <no-reply@pst.tl>"
MAIL_REPLY_TO=secretariado@pst.tl
# Where contact-form and aspiration copies are delivered.
MAIL_ADMIN_INBOX=secretariado@pst.tl

# ----------------------------------------------------------------------------
# SMS / OTP (membership status check by phone) — optional
# ----------------------------------------------------------------------------
OTP_TTL_SECONDS=300
OTP_MAX_ATTEMPTS=5
SMS_PROVIDER=none
SMS_API_URL=
SMS_API_KEY=
SMS_SENDER_ID=PST

# ----------------------------------------------------------------------------
# Public-form abuse protection
# ----------------------------------------------------------------------------
# Cloudflare Turnstile (privacy-friendly CAPTCHA). Leave empty to disable.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
RATE_LIMIT_REGISTER_PER_HOUR=5
RATE_LIMIT_ASPIRATION_PER_HOUR=5
RATE_LIMIT_CONTACT_PER_HOUR=10

# ----------------------------------------------------------------------------
# Public client config (exposed to the browser — no secrets here!)
# ----------------------------------------------------------------------------
NEXT_PUBLIC_APP_URL=https://pst.tl
NEXT_PUBLIC_DEFAULT_LOCALE=tet
NEXT_PUBLIC_MAP_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
NEXT_PUBLIC_MAP_ATTRIBUTION="© OpenStreetMap contributors"

# ----------------------------------------------------------------------------
# Observability
# ----------------------------------------------------------------------------
LOG_LEVEL=info
# Bearer token required by /api/health?details=1 (uptime monitor).
HEALTHCHECK_TOKEN=
SENTRY_DSN=

# ----------------------------------------------------------------------------
# Seed (used once by `npx prisma db seed`)
# ----------------------------------------------------------------------------
SEED_SUPER_ADMIN_EMAIL=admin@pst.tl
# Leave empty to generate a random one-time password (printed once).
SEED_SUPER_ADMIN_PASSWORD=
# Set to true to reset an existing super admin's password on the next seed.
SEED_SUPER_ADMIN_RESET=false

# ----------------------------------------------------------------------------
# Legacy migration (old PHP/MariaDB site `pst_db`) — Phase 4 importer
# ----------------------------------------------------------------------------
LEGACY_MYSQL_URL=mysql://user:password@localhost:3306/pst_db
# Root of the old PHP site (the folder that contains uploads/).
LEGACY_SITE_ROOT=./legacy/pst-website
